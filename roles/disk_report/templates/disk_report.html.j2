<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Disk Utilisation Report</title>
<style>
  :root {
    --bg: #f6f7f9; --panel: #ffffff; --text: #1d2330; --muted: #5d6677; --line: #e3e6eb;
    --ok: #2e7d4f; --warn: #b26a00; --crit: #c62828; --gap: #6b5fb5; --bar: #dde2e8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151b; --panel: #1b1f27; --text: #e7eaf0; --muted: #9aa3b2; --line: #2b313c;
      --ok: #5fbf86; --warn: #f0a83c; --crit: #ff6b6b; --gap: #a99cf0; --bar: #2b313c;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 32px 0 10px; }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .tile { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  .tile .v { font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .tile .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .tile.crit .v { color: var(--crit); } .tile.warn .v { color: var(--warn); } .tile.gap .v { color: var(--gap); }
  .wrap { overflow-x: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  tr:last-child td { border-bottom: 0; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill.ok { color: var(--ok); border: 1px solid var(--ok); }
  .pill.warning { color: var(--warn); border: 1px solid var(--warn); }
  .pill.critical { color: var(--crit); border: 1px solid var(--crit); }
  .pill.unknown, .pill.unreachable, .pill.error { color: var(--gap); border: 1px solid var(--gap); }
  .bar { position: relative; width: 140px; height: 8px; background: var(--bar); border-radius: 4px; display: inline-block; vertical-align: middle; margin-right: 8px; }
  .bar i { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background: var(--ok); }
  .bar i.warning { background: var(--warn); } .bar i.critical { background: var(--crit); }
  .muted { color: var(--muted); }
  .empty { padding: 16px; color: var(--muted); }
  footer { margin-top: 32px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<main>
  <h1>Disk utilisation</h1>
  <p class="sub">Generated {{ disk_report_generated }} &middot; warning &ge; {{ disk_warning_pct }}% &middot; critical &ge; {{ disk_critical_pct }}% (space or inodes)</p>

  <section class="tiles">
    <div class="tile"><div class="v">{{ disk_stats.hosts_reporting }}/{{ disk_stats.hosts_total }}</div><div class="k">Hosts reporting</div></div>
    <div class="tile"><div class="v">{{ disk_stats.accounts }}</div><div class="k">Accounts</div></div>
    <div class="tile"><div class="v">{{ disk_stats.filesystems }}</div><div class="k">Filesystems</div></div>
    <div class="tile crit"><div class="v">{{ disk_stats.critical }}</div><div class="k">Critical</div></div>
    <div class="tile warn"><div class="v">{{ disk_stats.warning }}</div><div class="k">Warning</div></div>
    <div class="tile gap"><div class="v">{{ disk_stats.hosts_gap }}</div><div class="k">Not reporting</div></div>
  </section>

  <h2>Needs attention</h2>
  <div class="wrap">
  {% if disk_findings %}
    <table>
      <thead><tr><th>Status</th><th>Used</th><th class="num">Free GB</th><th class="num">Inodes</th><th>Mount</th><th>Host</th><th>Account</th><th>Region</th></tr></thead>
      <tbody>
      {% for f in disk_findings %}
        <tr>
          <td><span class="pill {{ f.status }}">{{ f.status }}</span></td>
          <td><span class="bar"><i class="{{ f.status }}" style="width: {{ [f.used_pct, 100] | min }}%"></i></span>{{ f.used_pct }}%</td>
          <td class="num">{{ f.avail_gb }}</td>
          <td class="num">{{ f.inode_used_pct }}%</td>
          <td>{{ f.mount }}</td>
          <td>{{ f.name }} <span class="muted">{{ f.host }}</span></td>
          <td>{{ f.account_name }} <span class="muted">{{ f.account_id }}</span></td>
          <td>{{ f.region }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty">No filesystem is above the warning threshold.</div>
  {% endif %}
  </div>

  <h2>Coverage gaps</h2>
  <div class="wrap">
  {% if disk_gaps %}
    <table>
      <thead><tr><th>Status</th><th>Host</th><th>Account</th><th>Region</th><th>Reason</th></tr></thead>
      <tbody>
      {% for g in disk_gaps %}
        <tr>
          <td><span class="pill {{ g.collect_status }}">{{ g.collect_status }}</span></td>
          <td>{{ g.name }} <span class="muted">{{ g.host }}</span></td>
          <td>{{ g.account_name }} <span class="muted">{{ g.account_id }}</span></td>
          <td>{{ g.region }}</td>
          <td class="muted">{{ g.collect_error | e }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="empty">Every targeted host reported.</div>
  {% endif %}
  </div>

  <h2>By account</h2>
  <div class="wrap">
    <table>
      <thead><tr><th>Account</th><th class="num">Hosts</th><th class="num">Not reporting</th><th class="num">Critical FS</th><th class="num">Warning FS</th><th class="num">Fullest FS</th></tr></thead>
      <tbody>
      {% for acct, hosts in disk_fleet | groupby('account_id') %}
        {% set fss = hosts | map(attribute='filesystems') | flatten %}
        {% set used = fss | map(attribute='used_pct') | list %}
        <tr>
          <td>{{ (hosts | first).account_name }} <span class="muted">{{ acct }}</span></td>
          <td class="num">{{ hosts | length }}</td>
          <td class="num">{{ hosts | rejectattr('collect_status', 'equalto', 'ok') | list | length }}</td>
          <td class="num">{{ fss | selectattr('status', 'equalto', 'critical') | list | length }}</td>
          <td class="num">{{ fss | selectattr('status', 'equalto', 'warning') | list | length }}</td>
          <td class="num">{{ (used | max ~ '%') if used else '-' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>All filesystems</h2>
  <div class="wrap">
    <table>
      <thead><tr><th>Host</th><th>Mount</th><th>Type</th><th class="num">Size GB</th><th class="num">Free GB</th><th>Used</th><th class="num">Inodes</th><th>Status</th></tr></thead>
      <tbody>
      {% for h in disk_fleet | sort(attribute='host') if h.filesystems %}
        {% for fs in h.filesystems %}
        <tr>
          <td>{% if loop.first %}{{ h.name }} <span class="muted">{{ h.account_name }} / {{ h.region }} &middot; {{ h.os }}</span>{% endif %}</td>
          <td>{{ fs.mount }}</td>
          <td class="muted">{{ fs.fstype }}</td>
          <td class="num">{{ fs.size_gb }}</td>
          <td class="num">{{ fs.avail_gb }}</td>
          <td><span class="bar"><i class="{{ fs.status }}" style="width: {{ [fs.used_pct, 100] | min }}%"></i></span>{{ fs.used_pct }}%</td>
          <td class="num">{{ fs.inode_used_pct }}%</td>
          <td><span class="pill {{ fs.status }}">{{ fs.status }}</span></td>
        </tr>
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>

  <footer>Produced by playbooks/collect_disk_usage.yml. Machine-readable copies: disk_report.json, disk_report.csv.</footer>
</main>
</body>
</html>

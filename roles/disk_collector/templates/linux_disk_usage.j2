{#- used_pct counts root-reserved blocks as used: it reflects the space a
    non-root service can actually still write, which is what causes outages. -#}
{%- set rows = [] -%}
{%- set seen = [] -%}
{%- for m in ansible_mounts | sort(attribute='mount')
      if m.fstype not in disk_exclude_fstypes
      and m.mount is not match(disk_exclude_mount_regex)
      and (m.size_total | default(0) | int) > 0
      and m.mount not in seen -%}
{%-   set _ = seen.append(m.mount) -%}
{%-   set size = m.size_total | int -%}
{%-   set avail = m.size_available | default(0) | int -%}
{%-   set used_pct = ((size - avail) / size * 100) | round(1) -%}
{%-   set itotal = m.inode_total | default(0) | int -%}
{%-   set iavail = m.inode_available | default(0) | int -%}
{%-   set inode_pct = (((itotal - iavail) / itotal * 100) | round(1)) if itotal > 0 else 0.0 -%}
{%-   if used_pct >= disk_critical_pct or inode_pct >= inode_critical_pct -%}
{%-     set status = 'critical' -%}
{%-   elif used_pct >= disk_warning_pct or inode_pct >= inode_warning_pct -%}
{%-     set status = 'warning' -%}
{%-   else -%}
{%-     set status = 'ok' -%}
{%-   endif -%}
{%-   set _ = rows.append({
        'mount': m.mount,
        'device': m.device,
        'fstype': m.fstype,
        'size_gb': (size / 1073741824) | round(2),
        'avail_gb': (avail / 1073741824) | round(2),
        'used_pct': used_pct,
        'inode_used_pct': inode_pct,
        'status': status}) -%}
{%- endfor -%}
{{ rows | to_json }}

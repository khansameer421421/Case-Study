{%- set widgets = [] -%}
{%- set _ = widgets.append({
  'type': 'text', 'x': 0, 'y': 0, 'width': 24, 'height': 2,
  'properties': {'markdown': '## Disk utilisation - all linked accounts\nWarning ' ~ disk_warning_pct ~ '% / critical ' ~ disk_critical_pct ~ '%. Source: CloudWatch agent (`' ~ cwagent_namespace ~ '`) via cross-account observability. Hourly Ansible reports: `s3://' ~ report_s3_bucket ~ '/' ~ report_s3_prefix ~ '/latest/disk_report.html`'}}) -%}
{%- for region in dashboard_regions -%}
{%-   set y = 2 + loop.index0 * 14 -%}
{%-   set _ = widgets.append({
    'type': 'metric', 'x': 0, 'y': y, 'width': 16, 'height': 8,
    'properties': {
      'title': region ~ ' - 25 fullest filesystems',
      'region': region, 'view': 'timeSeries', 'stacked': false, 'period': 300,
      'metrics': [[{'id': 'q1', 'period': 300, 'label': '',
        'expression': 'SELECT MAX(disk_used_percent) FROM SCHEMA(' ~ cwagent_namespace ~ ', InstanceId, fstype, path) GROUP BY AWS.AccountId, InstanceId, path ORDER BY MAX() DESC LIMIT 25'}]],
      'yAxis': {'left': {'min': 0, 'max': 100, 'label': '% used', 'showUnits': false}},
      'annotations': {'horizontal': [
        {'label': 'warning', 'value': disk_warning_pct, 'color': '#ff9900'},
        {'label': 'critical', 'value': disk_critical_pct, 'color': '#d13212'}]}}}) -%}
{%-   set _ = widgets.append({
    'type': 'metric', 'x': 16, 'y': y, 'width': 8, 'height': 8,
    'properties': {
      'title': region ~ ' - fullest filesystem per account',
      'region': region, 'view': 'bar', 'period': 300,
      'metrics': [[{'id': 'q2', 'period': 300, 'label': '',
        'expression': 'SELECT MAX(disk_used_percent) FROM SCHEMA(' ~ cwagent_namespace ~ ', InstanceId, fstype, path) GROUP BY AWS.AccountId ORDER BY MAX() DESC'}]],
      'yAxis': {'left': {'min': 0, 'max': 100}}}}) -%}
{%-   set _ = widgets.append({
    'type': 'metric', 'x': 0, 'y': y + 8, 'width': 24, 'height': 6,
    'properties': {
      'title': region ~ ' - lowest free inodes (inode exhaustion fills a disk with space left)',
      'region': region, 'view': 'timeSeries', 'period': 300,
      'metrics': [[{'id': 'q3', 'period': 300, 'label': '',
        'expression': 'SELECT MIN(disk_inodes_free) FROM SCHEMA(' ~ cwagent_namespace ~ ', InstanceId, fstype, path) GROUP BY AWS.AccountId, InstanceId, path ORDER BY MIN() ASC LIMIT 10'}]]}}) -%}
{%- endfor -%}
{{ {'widgets': widgets} | to_nice_json(indent=2) }}

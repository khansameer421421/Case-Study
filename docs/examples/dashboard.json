{
  "widgets": [
    {
      "height": 2,
      "properties": {
        "markdown": "## Disk utilisation - all linked accounts\nWarning 80% / critical 90%. Source: CloudWatch agent (`CWAgent`) via cross-account observability. Hourly Ansible reports: `s3://disk-monitoring-111111111111-us-east-1/reports/latest/disk_report.html`"
      },
      "type": "text",
      "width": 24,
      "x": 0,
      "y": 0
    },
    {
      "height": 8,
      "properties": {
        "annotations": {
          "horizontal": [
            {
              "color": "#ff9900",
              "label": "warning",
              "value": 80
            },
            {
              "color": "#d13212",
              "label": "critical",
              "value": 90
            }
          ]
        },
        "metrics": [
          [
            {
              "expression": "SELECT MAX(disk_used_percent) FROM SCHEMA(CWAgent, InstanceId, fstype, path) GROUP BY AWS.AccountId, InstanceId, path ORDER BY MAX() DESC LIMIT 25",
              "id": "q1",
              "label": "",
              "period": 300
            }
          ]
        ],
        "period": 300,
        "region": "eu-central-1",
        "stacked": false,
        "title": "eu-central-1 - 25 fullest filesystems",
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "label": "% used",
            "max": 100,
            "min": 0,
            "showUnits": false
          }
        }
      },
      "type": "metric",
      "width": 16,
      "x": 0,
      "y": 2
